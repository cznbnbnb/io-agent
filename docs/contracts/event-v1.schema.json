{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turboio.local/contracts/v1/event.schema.json",
  "title": "Turbo IO minimal event v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "idempotency_key",
    "kind",
    "producer_id",
    "created_at",
    "expires_at",
    "body"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "kind": {
      "enum": [
        "material.revision",
        "message",
        "receipt",
        "task",
        "request",
        "answer"
      ]
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "body": {
      "type": "object"
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "computer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "computer_id",
        "agent_id",
        "project_id",
        "session_id"
      ]
    },
    "utterance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "utterance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "speaker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker_basis": {
          "enum": [
            "unknown",
            "segment_cluster",
            "user_confirmed"
          ]
        },
        "overlap": {
          "type": "boolean"
        }
      },
      "required": [
        "utterance_id",
        "start_ms",
        "end_ms",
        "text",
        "speaker_id",
        "speaker_basis",
        "overlap"
      ]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "material_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "enum": [
            "upsert",
            "delete"
          ]
        },
        "source": {
          "enum": [
            "recording",
            "lifelog",
            "agent_analysis"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "gap"
          ]
        },
        "text_revision": {
          "type": "integer",
          "minimum": 0
        },
        "utterances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/utterance"
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "local",
                "stored_verified",
                "missing",
                "not_retained"
              ]
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "object_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "sha256",
            "object_id"
          ]
        }
      },
      "required": [
        "material_id",
        "revision",
        "base_revision",
        "operation",
        "source",
        "started_at",
        "ended_at",
        "completeness",
        "text_revision",
        "utterances",
        "audio"
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "enum": [
            "command",
            "question",
            "answer",
            "progress",
            "result",
            "cancel"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": [
        "message_id",
        "revision",
        "route",
        "task_id",
        "request_id",
        "channel",
        "text"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subject_kind": {
          "enum": [
            "material",
            "message",
            "task",
            "request",
            "answer"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "subject_revision": {
          "type": "integer",
          "minimum": 1
        },
        "stage": {
          "enum": [
            "server_stored",
            "phone_received",
            "glasses_displayed",
            "user_answered",
            "agent_received",
            "task_resumed",
            "task_completed",
            "cancel_requested",
            "cancelled",
            "failed",
            "expired"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "related_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "retryable": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "string",
                  "maxLength": 512
                }
              },
              "required": [
                "code",
                "retryable",
                "detail"
              ]
            }
          ]
        }
      },
      "required": [
        "receipt_id",
        "subject_kind",
        "subject_id",
        "subject_revision",
        "stage",
        "actor_id",
        "related_event_id",
        "error"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "state": {
          "enum": [
            "queued",
            "agent_received",
            "running",
            "waiting_answer",
            "cancel_requested",
            "cancelled",
            "completed",
            "failed",
            "expired",
            "execution_unknown"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "allow_create_session": {
          "const": false
        }
      },
      "required": [
        "task_id",
        "revision",
        "route",
        "state",
        "command",
        "allow_create_session"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "mode": {
          "enum": [
            "choice",
            "free_text"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "options": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "option_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": [
              "option_id",
              "label"
            ]
          }
        },
        "state": {
          "enum": [
            "pending",
            "presented",
            "answered",
            "withdrawn",
            "expired"
          ]
        },
        "runtime_request_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "request_id",
        "revision",
        "task_id",
        "route",
        "mode",
        "question",
        "options",
        "state",
        "runtime_request_id"
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "answer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "option_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "input_source": {
          "enum": [
            "phone",
            "voice",
            "glasses_semantic"
          ]
        },
        "raw_action": {
          "const": null
        }
      },
      "required": [
        "answer_id",
        "request_id",
        "request_revision",
        "task_id",
        "route",
        "option_id",
        "text",
        "input_source",
        "raw_action"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "material.revision"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/material"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "message"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/message"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "receipt"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/receipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "answer"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/answer"
          }
        }
      }
    }
  ]
}
